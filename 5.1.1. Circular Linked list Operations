#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

struct node *first = NULL;

// Count nodes
int count(struct node *p) {
    if (p == NULL) return 0;
    int c = 0;
    struct node *temp = p;
    do {
        c++;
        temp = temp->next;
    } while (temp != p);
    return c;
}

// Create
struct node* createCLL(int n) {
    if (n <= 0) return NULL;

    struct node *temp, *last;
    int x;

    scanf("%d", &x);
    first = (struct node*)malloc(sizeof(struct node));
    first->data = x;
    first->next = first;
    last = first;

    for (int i = 1; i < n; i++) {
        scanf("%d", &x);
        temp = (struct node*)malloc(sizeof(struct node));
        temp->data = x;
        temp->next = first;
        last->next = temp;
        last = temp;
    }
    return first;
}

// Display
void displayCLL(struct node *p) {
    if (p == NULL) {
        printf("CLL is empty\n");
        return;
    }

    struct node *temp = p;
    printf("Elements in CLL are: ");
    do {
        printf("%d -> ", temp->data);
        temp = temp->next;
    } while (temp != p);
    printf("\n");
}

// Insert
struct node* insertCLL(struct node *p, int pos, int val) {
    int n = count(p);

    if (pos <= 0 || pos > n + 1) {
        printf("Position not found\n");
        return p;
    }

    struct node *temp = (struct node*)malloc(sizeof(struct node));
    temp->data = val;

    if (pos == 1) {
        if (p == NULL) {
            temp->next = temp;
            return temp;
        }

        struct node *last = p;
        while (last->next != p)
            last = last->next;

        temp->next = p;
        last->next = temp;
        return temp;
    }

    struct node *q = p;
    for (int i = 1; i < pos - 1; i++)
        q = q->next;

    temp->next = q->next;
    q->next = temp;

    return p;
}

// Delete
struct node* deleteCLL(struct node *p, int pos) {
    if (p == NULL) {
        printf("CLL is empty\n");
        return NULL;
    }

    int n = count(p);

    if (pos < 1 || pos > n) {
        printf("Position not found\n");
        return p;
    }

    struct node *q = p, *temp;
    int val;

    if (pos == 1) {
        while (q->next != p)
            q = q->next;

        val = p->data;

        if (q == p) {
            free(p);
            printf("Deleted element: %d\n", val);
            return NULL;
        }

        q->next = p->next;
        temp = p;
        p = p->next;
        free(temp);

        printf("Deleted element: %d\n", val);
        return p;
    }

    for (int i = 1; i < pos - 1; i++)
        q = q->next;

    temp = q->next;
    val = temp->data;

    q->next = temp->next;
    free(temp);

    printf("Deleted element: %d\n", val);
    return p;
}

// Reverse
struct node* reverseCLL(struct node *p) {
    if (p == NULL) {
        printf("CLL is empty\n");
        return NULL;
    }

    struct node *prev = NULL, *curr = p, *next;
    struct node *start = p;

    do {
        next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
    } while (curr != start);

    start->next = prev;
    p = prev;

    printf("CLL reversed\n");

    struct node *temp = p;
    do {
        printf("%d -> ", temp->data);
        temp = temp->next;
    } while (temp != p);
    printf("\n");

    return p;
}

// Concatenate
struct node* concat(struct node *p) {
    int n;
    printf("Creating second CLL to concatenate...\n");
    printf("How many nodes in second CLL? ");
    scanf("%d", &n);

    struct node *second = NULL, *temp, *last2;
    int x;

    if (n > 0) {
        scanf("%d", &x);
        second = (struct node*)malloc(sizeof(struct node));
        second->data = x;
        second->next = second;
        last2 = second;

        for (int i = 1; i < n; i++) {
            scanf("%d", &x);
            temp = (struct node*)malloc(sizeof(struct node));
            temp->data = x;
            temp->next = second;
            last2->next = temp;
            last2 = temp;
        }
    }

    if (p == NULL) return second;
    if (second == NULL) return p;

    struct node *last1 = p;
    while (last1->next != p)
        last1 = last1->next;

    while (last2->next != second)
        last2 = last2->next;

    last1->next = second;
    last2->next = p;

    printf("Concatenated CLL:\n");

    struct node *t = p;
    do {
        printf("%d -> ", t->data);
        t = t->next;
    } while (t != p);
    printf("\n");

    return p;
}

// Main
int main() {
    int choice, n, pos, val;

    while (1) {
        printf("1.Create 2.Insert 3.Delete 4.Display 5.Reverse 6.Concat 7.Exit\n");
        printf("choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1:
            printf("How many nodes? ");
            scanf("%d", &n);
            first = createCLL(n);
            break;

        case 2:
            printf("Position: ");
            scanf("%d", &pos);
            printf("Element: ");
            scanf("%d", &val);
            first = insertCLL(first, pos, val);
            break;

        case 3:
            printf("Position: ");
            scanf("%d", &pos);
            first = deleteCLL(first, pos);
            break;

        case 4:
            displayCLL(first);
            break;

        case 5:
            first = reverseCLL(first);
            break;

        case 6:
            first = concat(first);
            break;

        case 7:
            return 0;

        default:
            printf("Invalid choice\n");
        }
    }
}
 
