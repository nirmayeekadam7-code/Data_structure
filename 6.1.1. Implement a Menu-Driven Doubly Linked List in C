// Function to reverse the list
void reverseList() {
	if(head == NULL){
		printf("List is empty\n");
		return;
	}
struct Node* temp = NULL;
	struct Node* current = head;
	while(current != NULL){
		temp = current->prev;
		current->prev = current->next;
		current->next = temp;
		head = current;
		current = current->prev;
	}
	display();
}

